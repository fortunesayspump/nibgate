# Nibgate backend configuration.
# Copy to backend/.env (gitignored) and fill in values. Production (NODE_ENV=production)
# requires the secrets marked REQUIRED — the backend fails loud instead of using a fallback.

# ── Required in production (fail-loud) ────────────────────────────────────────
JWT_SECRET=                 # HMAC key for blog link tokens (hub blog linking)
NIBGATE_GATEWAY_SECRET=     # HMAC secret for nibshare payment proofs / media access
NIBGATE_SHARE_KEY_SECRET=   # KEK wrapping nibshare content keys (envelope encryption)
METRIC_HASH_SALT=           # salt for visitor/event hashing (alternatives: SESSION_SECRET, NIBGATE_INDEXER_SECRET)

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/nibgate

# ── Object storage (R2) ───────────────────────────────────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=              # public CDN base for previews + ciphertextUrl

# ── Payments (x402 / Circle Gateway, Arc Testnet) ─────────────────────────────
NIBGATE_PAYMENT_NETWORK=eip155:5042002
NIBGATE_FACILITATOR_URL=https://gateway-api-testnet.circle.com
CIRCLE_API_KEY=             # gateway balance lookups
NIBGATE_PAYMENT_MODE=demo
NIBGATE_SELLER_ADDRESS=     # default receiver wallet

# ── Nibshare ──────────────────────────────────────────────────────────────────
NIBGATE_SHARE_BASE_URL=https://nibgate.xyz/ns
NIBGATE_SHARE_KEY_SECRET=   # KEK: wraps each share's content key (envelope encryption); required in prod
NIBGATE_PROOF_SECRET=       # fallback HMAC secret for proofs (NIBGATE_GATEWAY_SECRET preferred)

# ── Arc RPC ───────────────────────────────────────────────────────────────────
ARC_RPC_URL=https://rpc.testnet.arc.io
# Local-only override (never for docs): ARC_RPC_URL=https://rpc.testnet.arc-node.thecanteenapp.com/v1/

# ── Revenue (per-creator fee on hosted unlocks) ───────────────────────────────
# Fee is dormant until NIBGATE_HOSTED_PAY=true AND a factory is deployed.
NIBGATE_HOSTED_PAY=false
NIBGATE_FEE_WALLET_FACTORY=      # GatewayFeeWalletFactory address (predictedWallet read)
NIBGATE_FEE_KEEPER=false         # enable the backend keeper sweep (default 60s)
NIBGATE_KEEPER_PRIVATE_KEY=      # gas-funded EOA for gatewayMint + distribute
NIBGATE_PAYMENT_RPC_URL=https://rpc.testnet.arc.io
NIBGATE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NIBGATE_GATEWAY_DOMAIN=26
NIBGATE_GATEWAY_WALLET=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
NIBGATE_GATEWAY_MINTER=0x0022222ABE238Cc2C7Bb1f21003F0a260052475B
NIBGATE_GATEWAY_API=https://gateway-api-testnet.circle.com/v1

# ── Misc ──────────────────────────────────────────────────────────────────────
PORT=3000
NIBGATE_STATE_PATH=
NIBGATE_SITE_NAME=Nibgate
NIBGATE_SITE_ORIGIN=https://nibgate.xyz
