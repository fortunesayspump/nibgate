PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://localhost:5432/nibgate_blog"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ACCESS_EXPIRATION_MINUTES=1440
JWT_REFRESH_EXPIRATION_DAYS=30

# Nibgate premium gating (optional)
NIBGATE_SECRET=server-only-unlock-secret
NIBGATE_SELLER_ADDRESS=0xYourWalletAddress
NIBGATE_PAYMENT_NETWORK=eip155:5042002
NIBGATE_DEFAULT_PRICE=0.01
