{
  "name": "nibgate-api-metadata",
  "account_id": "5168d18094624a42a2e019a74f50324b",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "node cloudflare/api-metadata/generate.mjs --check"
  },
  "routes": [
    {
      "pattern": "testnet-api.nibgate.xyz/mcp*",
      "zone_id": "cd027bdd5438bc1a43aea893925616bc"
    },
    {
      "pattern": "testnet-api.nibgate.xyz/.well-known/mcp.json*",
      "zone_id": "cd027bdd5438bc1a43aea893925616bc"
    },
    {
      "pattern": "testnet-api.nibgate.xyz/openapi.json*",
      "zone_id": "cd027bdd5438bc1a43aea893925616bc"
    },
    {
      "pattern": "testnet-api.nibgate.xyz/api/openapi.json*",
      "zone_id": "cd027bdd5438bc1a43aea893925616bc"
    },
    {
      "pattern": "api.nibgate.xyz/mcp*",
      "zone_id": "cd027bdd5438bc1a43aea893925616bc"
    },
    {
      "pattern": "api.nibgate.xyz/.well-known/mcp.json*",
      "zone_id": "cd027bdd5438bc1a43aea893925616bc"
    },
    {
      "pattern": "api.nibgate.xyz/openapi.json*",
      "zone_id": "cd027bdd5438bc1a43aea893925616bc"
    },
    {
      "pattern": "api.nibgate.xyz/api/openapi.json*",
      "zone_id": "cd027bdd5438bc1a43aea893925616bc"
    }
  ]
}
