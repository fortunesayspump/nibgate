{
  "name": "nibgate-lowfi-do-production",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RENDER",
        "class_name": "RenderObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RenderObject"
      ]
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nibgate-lowfi-do-production"
    }
  ],
  "routes": [
    {
      "pattern": "lowfi.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    }
  ]
}
