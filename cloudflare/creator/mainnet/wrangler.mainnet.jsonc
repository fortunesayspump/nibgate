{
  "name": "nibgate-creators-mainnet-public",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RENDER",
        "class_name": "RenderObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RenderObject"
      ]
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nibgate-creators-mainnet-public"
    }
  ],
  "routes": [
    {
      "pattern": "analog.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "bassdrop.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "beatlab.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "canvasandcode.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "catwalk.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "codekitchen.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "courtside.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "deepcook.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "fieldnotes.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "framerate.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "goldenhour.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "greenhouse.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
