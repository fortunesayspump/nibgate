      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "northloop.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "opentab.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    },
    {
      "pattern": "outbound.nibgate.xyz/*",
