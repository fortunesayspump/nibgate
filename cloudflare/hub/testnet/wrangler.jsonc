{
  "name": "nibgate-hub-testnet",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RENDER",
        "class_name": "HubRenderObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "HubRenderObject"
      ]
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nibgate-hub-testnet"
    }
  ],
  "find_additional_modules": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/open-next.mjs"
      ],
      "fallthrough": true
    },
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": [
        "**/*.bin"
      ],
      "fallthrough": true
    }
  ],
  "routes": [
    {
      "pattern": "testnet.nibgate.xyz/*",
      "zone_name": "nibgate.xyz"
    }
  ]
}
