{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nibgate-docs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "docs.nibgate.xyz",
      "custom_domain": true
    }
  ]
}
