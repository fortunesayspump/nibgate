# Dr. Nib backend configuration. Copy to dr-nib/backend/.env (gitignored).
PORT=3100
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/nibgate
REDIS_URL=redis://127.0.0.1:6379
# LLM supply (OpenRouter; JEV decisions run here too)
OPENROUTER_API_KEY=
JEV_DECISIONS_MODEL=~typesafe/jev-latest
# Retrieval providers (metered per call into run budgets)
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
# Exports (R2, same bucket conventions as hub media)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nibgate-media
R2_PUBLIC_URL=
# Hub (JEV endpoints + x402 top-ups when not imported as a package)
HUB_API_URL=http://localhost:3000
# CORS origins for the hub frontend
CORS_ORIGIN=http://localhost:3001
