# Dr. Nib backend configuration. Copy to dr-nib/backend/.env (gitignored).
PORT=3100

# Dr. Nib has no users of its own. Accounts are hub accounts: the API reads the
# hub's SIWE session cookie and validates it against the hub's Postgres via
# @nibgate/internal/auth.js — the exact same code path the hub uses. HUB_DATABASE_URL
# points at that hub database (its Session/User tables); do not point it at dr-nib's
# own schema or authentication breaks.
HUB_DATABASE_URL=postgresql://user:pass@host:5432/nibgate

# Research tables live in their OWN SCHEMA on the same cluster (not the hub's
# public schema, not hub tables). Change the schema name to isolate environments.
DRNIB_DATABASE_URL=postgresql://user:pass@host:5432/nibgate?schema=drnib

# No REDIS_URL -> the inline queue runs stages in-process (fine for one worker).
# Set it to move stages onto BullMQ for durable/scalable execution.
REDIS_URL=

# Hub (JEV decisions + x402 top-ups). JEV is reached through the hub: the
# decision seat that every run branch point consults. If it is unreachable the
# run parks rather than letting the model decide.
HUB_API_URL=http://localhost:3000
JEV_TIMEOUT_MS=60000

# CORS origin for the hub frontend. Only needed when the browser talks to this
# service cross-origin — going through the frontend's /drnib proxy (the default)
# makes requests same-origin, so the session cookie just works.
CORS_ORIGIN=http://localhost:3001

# Operational kill switch: 1/true answers 503 on every run route (health stays
# up). Flip per deployment to pull the backend off a stack without a deploy.
DRNIB_DISABLED=

# Explicit network (mainnet|testnet). Otherwise inferred from HUB_API_URL
# (a "testnet" host → testnet, anything else → mainnet).
DRNIB_NETWORK=

# LLM supply. Dr. Nib does NOT pick models: it calls the JEV router on
# OpenRouter (`typesafe/jev-router`), which chooses the model and reasoning
# effort per request, balancing quality, speed, and cost. The pipeline only
# sets intensity via reasoning_effort. JEV decisions share the same key.
#
# Note: research "depth" (quick/standard/deep) is a property of the run — how
# wide the branch tree grows and how many sources it opens — NOT a model.
# Never wire depth to a model id.
OPENROUTER_API_KEY=
LLM_MODEL=typesafe/jev-router
# Explicit server-side failover, tried in order when the router itself errors
# (rate-limit, downtime, moderation, context length). OpenRouter charges only
# for the model that served, so a lost response can never double-spend — which
# a client-side retry loop cannot guarantee. Normally empty: the router already
# carries its own internal fallbacks.
LLM_FALLBACK_MODELS=
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT_MS=120000
JEV_DECISIONS_MODEL=~typesafe/jev-latest

# Retrieval providers (metered per call into run budgets). Tavily gives
# breadth; Exa gives semantic/academic reach. Both optional; with neither set,
# the worker labels its stages as offline stubs and invents no sources.
# SearXNG is keyless and joins the free bench whenever its URL is set.
SEARXNG_URL=
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
# USD per Tavily credit, used to meter Tavily calls (Tavily reports credits,
# not dollars). Default 0.008.
TAVILY_CREDIT_USD=0.008

# Sandboxed code execution (Railway sandboxes). Optional: without these the
# run_code tool reports itself unavailable and the agent falls back to compute.
# The token is a Railway account/workspace token; the environment id is the
# target environment sandboxes are created in. Sandboxes run ISOLATED (no
# private network) and are destroyed when the run finishes.
RAILWAY_API_TOKEN=
RAILWAY_ENVIRONMENT_ID=
DRNIB_SANDBOX_IDLE_MINUTES=10

# Agent spending wallet (custodial hot key, per-network). Fund the derived
# address with USDC for tips / paid unlocks / x402. Without it the spend tools
# do not exist.
DRNIB_AGENT_PRIVATE_KEY=
DRNIB_SELLER_ADDRESS=

# Gate 2 mandate: when set, direct USDC tips route through NibgateSpender
# (daily cap + fail-secure recipient allowlist) instead of the raw EOA.
# Testnet: 0x903b0606da40d99d78da9d9be6c435acacba5cf0. Leave unset to keep
# the legacy EOA path.
DRNIB_SPENDER_ADDRESS=

# Research escrow (ERC-8183 core + NibgateRunSplitter, see dr-nib/ESCROW.md).
# Testnet has built-in contract defaults; mainnet requires ESCROW_CORE +
# ESCROW_SPLITTER. isEscrowConfigured() also requires the keeper key (or
# NIBGATE_KEEPER_PRIVATE_KEY), or the escrow routes answer 501.
ESCROW_CORE=
ESCROW_SPLITTER=
ESCROW_KEEPER_KEY=
ESCROW_TREASURY=
ESCROW_FEE_BPS=100

# Exports (R2, same bucket conventions as hub media)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nibgate-media
R2_PUBLIC_URL=