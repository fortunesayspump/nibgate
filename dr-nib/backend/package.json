{
  "name": "@nibgate/dr-nib-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dr. Nib worker service: research pipeline, budget engine, exports.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "start:prod": "prisma generate --schema=./prisma/schema.prisma && node src/server.js",
    "worker": "node src/worker.js",
    "worker:prod": "prisma generate --schema=./prisma/schema.prisma && node src/worker.js",
    "db:push": "npx prisma db push --schema=./prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "db:sql": "npx prisma db execute --schema=./prisma/schema.prisma --stdin",
    "test": "vitest run && node --test src/privacy/*.test.mjs",
    "test:vitest": "vitest run",
    "test:privacy": "node --test src/privacy/*.test.mjs",
    "test:watch": "vitest",
    "eval:agent": "vitest run src/agent"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@circle-fin/x402-batching": "^3.2.0",
    "@nibgate/internal": "workspace:*",
    "@phala/aci-verifier": "0.7.3",
    "@phala/cloud": "0.4.0",
    "@phala/dstack-sdk": "0.5.8",
    "@prisma/client": "^5.22.0",
    "@tesseract.js-data/eng": "1.0.0",
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "hpke": "1.1.7",
    "ioredis": "^5.4.1",
    "jose": "6.2.4",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "railway": "^3.12.0",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0",
    "unpdf": "^1.8.1",
    "viem": "^2.54.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.22.0",
    "supertest": "^7.3.0",
    "vitest": "^3.2.7"
  }
}
