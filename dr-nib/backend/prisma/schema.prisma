generator client {
  provider = "prisma-client-js"
}

// This datasource is Dr. Nib's own schema on the hub cluster â€” research tables
// only, never hub tables. DATABASE_URL is deliberately not used here: in this
// service that name means the *hub* database (see src/env.js), and reusing it
// for our own tables is exactly the confusion worth making impossible.
datasource db {
  provider = "postgresql"
  url      = env("DRNIB_DATABASE_URL")
}

model ResearchRun {
  id          String    @id @default(uuid())
  userId      String? // hub account that owns this project (no FK: hub tables live in another schema)
  walletAddress String?
  title       String?
  description String?
  brief       Json
  metadata    Json      @default("{}")
  plan        Json?
  depth       String    @default("standard")
  status      String    @default("draft")
  /// Why a run is parked: user | cap | error | jev | awaiting. Null while it is
  /// moving. The UI says different things for each, and resume only makes sense
  /// for some of them.
  pauseReason String?
  /// The question the run is blocked on, if it is blocked on one. The run stays
  /// parked until this is answered â€” it is the mid-run question card.
  pendingQuestion Json?
  /// Guidance typed while the run was moving, held until the current stage
  /// finishes so a stage never reads half-written input.
  pendingGuidance Json?
  /// Prepaid cap. Deposits are held against it; spends draw it down; the
  /// remainder is refunded on settle.
  budgetCap   Decimal   @db.Decimal(18, 6) @default(0)
  endedAt     DateTime?
  settledAt   DateTime?
  versions    Int       @default(1)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  steps       ResearchStep[]
  sources     ResearchSource[]
  claims      ResearchClaim[]
  reports     ResearchReport[]
  exports     ResearchExport[]
  ledger      BudgetLedger[]
  decisions   ResearchDecision[]
  events      ResearchEvent[]
  privateObjects PrivateWorkerObject[]
  privateClientObjects PrivateClientObject[]
  privateToolCalls PrivateToolCall[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([deletedAt])
}

/// Confidential worker content only. The kind, opaque object ID, revision and
/// timestamps are disclosed metadata; all document-derived values live in an
/// authenticated encrypted envelope. This additive table is not a migration
/// of the legacy plaintext models.
model PrivateWorkerObject {
  id        String      @id @default(uuid())
  runId     String
  run       ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind      String
  objectId  String
  revision  Int
  envelope  Json
  createdAt DateTime    @default(now())

  @@unique([runId, kind, objectId, revision])
  @@index([runId, kind, createdAt])
}

/// One durable, global-budget admission for a confidential AI run. The
/// reservation is counted in full until all attempted calls have independently
/// verified, request-bound signed usage. This table contains no prompt,
/// response, provider error, or receipt body.
model PrivateAiBudgetReservation {
  id                         String      @id @default(uuid())
  runId                      String      @unique
  tenantId                   String
  monthKey                   String
  model                      String
  maxCalls                   Int
  maxPromptBytesPerCall      Int
  maxOutputTokensPerCall     Int
  reservedMicroUsd           BigInt
  committedMicroUsd          BigInt
  verifiedCalls              Int         @default(0)
  status                     String      @default("reserved")
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt
  finishedAt                 DateTime?

  @@index([monthKey, status])
  @@index([tenantId, createdAt])
}

model ResearchStep {
  id        String    @id @default(uuid())
  runId     String
  run       ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind      String
  status    String    @default("pending")
  attempt   Int       @default(1)
  input     Json?
  output    Json?
  cost      Decimal   @db.Decimal(18, 6) @default(0)
  /// Crash-recovery lease. A step that is still `active` after its lease
  /// expired belongs to a dead worker: the boot sweeper resets it to
  /// `pending` and re-enqueues the run. A live step renews its lease on a
  /// heartbeat so a slow stage (long LLM call, big crawl) is never mistaken
  /// for a dead one.
  workerId    String?
  leaseUntil  DateTime?
  heartbeatAt DateTime?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([runId, kind])
  @@index([status, leaseUntil])
}

model ResearchSource {
  id        String   @id @default(uuid())
  runId     String
  run       ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  domain    String?
  relevance Float?
  trust     Float?
  cost      Decimal   @db.Decimal(18, 6) @default(0)
  createdAt DateTime @default(now())

  @@unique([runId, url])
  @@index([runId])
}

model ResearchClaim {
  id        String   @id @default(uuid())
  runId     String
  run       ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  text      String
  status    String   @default("unknown")
  passages  Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([runId])
}

model ResearchReport {
  id        String   @id @default(uuid())
  runId     String
  run       ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  version   Int
  markdown  String
  citations Json     @default("[]")
  createdAt DateTime @default(now())

  @@unique([runId, version])
  @@index([runId])
}

model ResearchExport {
  id            String   @id @default(uuid())
  runId         String
  run           ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  reportVersion Int
  format        String
  r2Key         String?
  status        String   @default("queued")
  createdAt     DateTime @default(now())

  @@index([runId])
}

/// Append-only money log, the source of truth for a run's balance.
/// kind: deposit (funds held against the cap, including raises) | spend (drawn
/// down by a stage) | fee (the platform's cut, taken as spends happen) |
/// refund (unspent remainder returned when a run settles). Amounts are never
/// negative. Ordinary balance subtracts fees separately; private settlement
/// includes the fee within spend, so its balance is deposits − spends − refunds.
model BudgetLedger {
  id        String   @id @default(uuid())
  runId     String
  run       ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind      String
  amount    Decimal   @db.Decimal(18, 6)
  txRef     String?
  createdAt DateTime @default(now())

  @@index([runId])
}

/// One entry in the run's decision log. kind="question" rows are the intake
/// transcript (prompt, options, the user's answer); kind="decision" rows record
/// what JEV was shown and what it returned. seq gives the transcript its order so
/// the wizard can step back and forward and resume mid-intake.
model ResearchDecision {
  id         String    @id @default(uuid())
  runId      String
  run        ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq        Int       @default(0)
  kind       String    @default("decision")
  type       String?
  step       String
  prompt     String?
  question   Json
  criteria   Json?
  answer     Json?
  output     Json?
  confidence Float?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([runId, seq])
  @@index([runId, kind])
}

/// Idempotency records for mutating routes. A retried request with the same
/// Idempotency-Key (a double-click, a dropped connection retried) replays the
/// stored response instead of executing twice — critical when the second
/// execution would spend money. Scoped per user so keys never leak across
/// accounts. statusCode 0 means in flight (a concurrent duplicate gets 409).
model IdempotencyKey {
  id         String   @id @default(uuid())
  userId     String
  key        String
  statusCode Int      @default(0)
  response   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

/// Per-user memory of which domains earned citations.
///
/// After a report ships, every domain the run read gets reads+1 and every
/// domain it actually cited gets cites+1. Future runs consult the rate before
/// judging trust — a source that proved useful before starts with evidence
/// behind it. Read-but-uncited counts as read, never as a demerit: a source
/// the run skipped was never given the chance, and counting that as a miss
/// would let one skip justify the next.
model QueryMemory {
  id        String   @id @default(uuid())
  userId    String
  domain    String
  reads     Int      @default(0)
  cites     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, domain])
  @@index([userId])
}

/// The durable, ordered event log for a run. Every SSE event is written here
/// before it is broadcast, so a client that disconnects at step five can
/// reconnect and replay from step six, and the run's whole history is
/// inspectable after the fact. `seq` is per-run and monotonic, which is what
/// makes replay exact (`?after=<seq>` or the SSE Last-Event-ID header).
model ResearchEvent {
  id        String   @id @default(uuid())
  runId     String
  run       ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@index([runId, seq])
}

/// Episodic agent memory (Reflexion-lite): one verbal lesson distilled per
/// failed run. Retrieved by task similarity and injected into future runs.
/// Bounded by application code (LIMITS.lessonsMax), not the schema.
model AgentLesson {
  id         String   @id @default(uuid())
  task       String
  lesson     String
  stopReason String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Opaque client-controlled recovery envelopes. No unwrapped key belongs here.
model PrivateVaultRecord {
  userId String @id
  vaultId String @unique
  revision Int @default(1)
  recoveryEnvelope Json
  passkey Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Inactive vaults remain encrypted and belong to the same signed-in account.
/// Switching vaults swaps one of these records with PrivateVaultRecord inside
/// an owner-locked transaction; project ciphertext is never re-keyed or erased.
model PrivateVaultStored {
  vaultId String @id
  userId String
  revision Int
  recoveryEnvelope Json
  passkey Json?
  createdAt DateTime
  updatedAt DateTime

  @@index([userId, createdAt])
}

/// Ciphertext uploaded by clients. Sources may use private object storage;
/// small manifests and wrapped project keys stay inline. Revisions are CAS.
model PrivateClientObject {
  id String @id @default(uuid())
  runId String
  run ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  vaultId String
  objectId String
  kind String
  revision Int
  envelope Json?
  objectKey String?
  digest String
  removed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([runId, objectId])
  @@index([runId, kind, removed])
}

/// Request idempotency and ciphertext-only result for confidential commands.
model PrivateActionReceipt {
 id String @id @default(uuid())
 runId String
 requestId String
 digest String
 status String
 reply Json?
 leaseOwner String?
 leaseUntil DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([runId, requestId])
 @@index([runId, status])
}
/// Provider-call admission keyed to the action, separate from the legacy
/// source-only job reservation so an uncertain call is never replayed.
model PrivateInferenceCall {
 id String @id
 runId String
 actionId String
 model String
 billingKind String @default("owner-test")
 costBasis String @default("legacy-ceiling")
 usageEvidence Json?
 reservedMicroUsd BigInt
 committedMicroUsd BigInt
 status String
 monthKey String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([monthKey, status])
 @@index([runId, actionId])
 @@index([runId, billingKind])
}

/// Only explicitly approved public requests and ciphertext result delivery.
/// No research document, prompt, wallet key or project decryption key.
model PrivateToolCall {
 id String @id
 runId String
 run ResearchRun @relation(fields:[runId],references:[id],onDelete:Cascade)
 questionId String
 tool String
 request Json
 requestDigest String
 manifestRevision Int
 recipientPublicKey String
 recipientId String
 status String @default("approved")
 reservedMicroUsd BigInt
 committedMicroUsd BigInt @default(0)
 costBasis String @default("reservation")
 paymentEvidence Json?
 resultEnvelope Json?
 resultDigest String?
 txHash String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([runId,questionId])
 @@index([runId,status])
}

/// Ordinary ciphertext-free lifecycle metadata. Holds contain only random IDs
/// and expiry times; never content keys, prompts or provider credentials.
model PrivateWorkerLifecycle {
 id String @id
 state Json
 updatedAt DateTime @default(now()) @db.Timestamptz(6)
}
