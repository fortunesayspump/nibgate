# Tests run against a real Postgres schema, not SQLite or a mock: the money
# rules are arithmetic on rows and decimals, and a fake would test the fake.
#
# Copy this file to ../.env.test (gitignored) and point DRNIB_DATABASE_URL at a
# throwaway schema. The name MUST end in _test — the test setup refuses to
# start otherwise, so a stray run can never touch development data.
#
# Same cluster your hub uses is fine; a separate local Postgres is better.
DRNIB_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/postgres?schema=drnib_test

# Present because src/env.js validates both on import, even though the tests
# never authenticate against the hub.
HUB_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/postgres