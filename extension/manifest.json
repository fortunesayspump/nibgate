{
  "manifest_version": 3,
  "name": "Nibgate",
  "version": "1.0.1",
  "description": "Tip creators anywhere on the web with USDC. Starts on testnet (free faucet funds); switch to mainnet from the header network pill for real payments.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Nibgate",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "alarms", "idle"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "host_permissions": [
    "https://testnet-api.nibgate.xyz/*",
    "https://testnet-api-subblogs.nibgate.xyz/*",
    "https://api.nibgate.xyz/*",
    "https://api-subblogs.nibgate.xyz/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
