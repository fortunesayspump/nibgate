{
  "name": "nibgate-extension",
  "version": "1.2.1",
  "private": true,
  "description": "Nibgate browser extension for Arc testnet and mainnet.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/context-menu.test.mjs scripts/content-detection.test.mjs scripts/popup-password.test.mjs",
    "test:sites": "node scripts/audit-content-pages.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "3.2.0",
    "@mozilla/readability": "^0.6.0",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "qrcode-generator": "^2.0.4",
    "viem": "^2.56.9"
  }
}
