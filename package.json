{
  "name": "nibgate-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace for the Nibgate app, CLI package, and example origin sites.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "docs",
    "frontend",
    "backend",
    "dr-nib/backend",
    "packages/*",
    "subblogs/frontend",
    "subblogs/backend"
  ],
  "scripts": {
    "build": "echo 'no root build needed'",
    "start": "npm run start --workspace=@nibgate/backend",
    "dev": "pnpm --filter @nibgate/frontend build && pnpm --filter @nibgate/backend dev",
    "dev:demo": "cd demo && pnpm install && node server.js",
    "dev:cli": "pnpm --filter @nibgate/cli dev",
    "dev:backend": "pnpm --filter @nibgate/backend dev",
    "dev:docs": "pnpm --filter @nibgate/docs dev",
    "dev:frontend": "pnpm --filter @nibgate/frontend dev",
    "build:docs": "pnpm --filter @nibgate/docs build",
    "build:frontend": "pnpm --filter @nibgate/frontend build",
    "routes": "pnpm --filter @nibgate/cli routes",
    "networks:check": "node scripts/check-network-sync.mjs",
    "deps:check": "node scripts/check-sdk-versions.mjs",
    "gsc:sitemaps": "node scripts/gsc-sitemap-submit.mjs",
    "gsc:index": "node scripts/gsc-index-status.mjs",
    "e2e:nibgate": "node scripts/e2e-nibgate-flow.mjs",
    "test": "node --test scripts/wallet-rpc-routing.test.mjs && pnpm --filter @nibgate/sdk test && pnpm --filter @nibgate/backend test && node scripts/check-network-sync.mjs",
    "test:watch": "pnpm --filter @nibgate/sdk test:watch",
    "workspace:check": "node scripts/check-workspace-integrity.mjs",
    "test:regressions": "node --test scripts/*.test.mjs",
    "test:tip-postgres": "node scripts/test-tip-postgres.mjs",
    "test:drnib-postgres": "node scripts/test-drnib-postgres.mjs"
  },
  "pnpm": {
    "overrides": {
      "viem": "2.54.1",
      "@wagmi/connectors": "8.0.20",
      "@tiptap/core": "3.31.4",
      "@tiptap/extension-blockquote": "3.31.4",
      "@tiptap/extension-bold": "3.31.4",
      "@tiptap/extension-bubble-menu": "3.31.4",
      "@tiptap/extension-bullet-list": "3.31.4",
      "@tiptap/extension-code-block": "3.31.4",
      "@tiptap/extension-code": "3.31.4",
      "@tiptap/extension-document": "3.31.4",
      "@tiptap/extension-dropcursor": "3.31.4",
      "@tiptap/extension-floating-menu": "3.31.4",
      "@tiptap/extension-gapcursor": "3.31.4",
      "@tiptap/extension-hard-break": "3.31.4",
      "@tiptap/extension-heading": "3.31.4",
      "@tiptap/extension-horizontal-rule": "3.31.4",
      "@tiptap/extension-image": "3.31.4",
      "@tiptap/extension-italic": "3.31.4",
      "@tiptap/extension-link": "3.31.4",
      "@tiptap/extension-list-item": "3.31.4",
      "@tiptap/extension-list-keymap": "3.31.4",
      "@tiptap/extension-list": "3.31.4",
      "@tiptap/extension-ordered-list": "3.31.4",
      "@tiptap/extension-paragraph": "3.31.4",
      "@tiptap/extension-placeholder": "3.31.4",
      "@tiptap/extension-strike": "3.31.4",
      "@tiptap/extension-table-cell": "3.31.4",
      "@tiptap/extension-table-header": "3.31.4",
      "@tiptap/extension-table-row": "3.31.4",
      "@tiptap/extension-table": "3.31.4",
      "@tiptap/extension-task-item": "3.31.4",
      "@tiptap/extension-task-list": "3.31.4",
      "@tiptap/extension-text": "3.31.4",
      "@tiptap/extension-typography": "3.31.4",
      "@tiptap/extension-underline": "3.31.4",
      "@tiptap/extensions": "3.31.4",
      "@tiptap/pm": "3.31.4",
      "@tiptap/react": "3.31.4",
      "@tiptap/starter-kit": "3.31.4",
      "@tiptap/suggestion": "3.31.4",
      "@coinbase/cdp-sdk": "1.51.2"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "viem": "2.54.1",
    "vitest": "^3.2.1"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fortunesayspump/nibgate.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/fortunesayspump/nibgate/issues"
  },
  "homepage": "https://github.com/fortunesayspump/nibgate#readme"
}
