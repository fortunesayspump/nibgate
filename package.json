{
  "name": "nibgate-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace for the Nibgate app, CLI package, and example origin sites.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "app",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev:cli": "npm --workspace nibgate run dev",
    "dev:app": "npm run build:app && npm --workspace app run app",
    "dev:app:api": "npm --workspace app run app",
    "dev:app:web": "npm --workspace app run web",
    "dev:example:blog": "npm --workspace @nibgate/example-blog run dev",
    "build:app": "npm --workspace app run web:build",
    "routes": "npm --workspace nibgate run routes"
  }
}
