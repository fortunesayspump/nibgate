// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid())
  walletAddress String     @unique
  username      String?
  bio           String?
  avatarUrl     String?
  coverUrl      String?
  websiteUrl    String?
  twitterUrl    String?
  instagramUrl  String?
  tiktokUrl     String?
  youtubeUrl    String?
  createdAt     DateTime   @default(now())
  sessions      Session[]
  wallets       Wallet[]
  websites      Website[]
  blogPosts     BlogPost[]
}

model Wallet {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address    String   @unique
  chainId    Int?
  isPrimary  Boolean  @default(false)
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  nonce     String? // Temporary nonce for SIWE login challenges
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Website {
  id                        String              @id @default(uuid())
  domain                    String              @unique
  name                      String
  description               String?
  ownerId                   String
  owner                     User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isVerified                Boolean             @default(false)
  verificationStatus        String              @default("pending")
  lastVerifiedAt            DateTime?
  lastVerificationCheckAt   DateTime?
  verificationFailureReason String?
  verificationFailures      Int                 @default(0)
  verifyToken               String
  siteToken                 String              @unique
  faviconUrl                String?
  ogImageUrl                String?
  lastScanAt                DateTime?
  lastScanStatus            String?
  lastScanError             String?
  lastSyncAt                DateTime?
  createdAt                 DateTime            @default(now())
  deletedAt                 DateTime?
  content                   Content[]
  metrics                   Metric[]
  unlockReceipts            UnlockReceipt[]
  ratings                   ContentRating[]
  publishers                PublisherIdentity[]
}

model PublisherIdentity {
  id             String          @id @default(uuid())
  websiteId      String
  website        Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  externalId     String
  handle         String?
  name           String?
  walletAddress  String?
  profileUrl     String?
  verification   String          @default("platform_attested")
  metadata       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  content        Content[]
  metrics        Metric[]
  unlockReceipts UnlockReceipt[]
  ratings        ContentRating[]

  @@unique([websiteId, externalId])
  @@index([websiteId])
  @@index([walletAddress])
  @@index([handle])
}

model Content {
  id                    String             @id @default(uuid())
  websiteId             String
  website               Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  publisherId           String?
  publisher             PublisherIdentity? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  publisherExternalId   String?
  publisherHandle       String?
  publisherWallet       String?
  publisherProfileUrl   String?
  publisherVerification String?
  externalId            String?
  title                 String
  description           String?
  imageUrl              String?
  contentType           String             @default("article") // music, video, article, image
  tags                  String? // Comma-separated tags for the search engine
  url                   String
  path                  String?
  currency              String             @default("USDC")
  price                 Float // Price to unlock in USDC
  recipientWallet       String?
  accessPolicy          String?
  unlockPolicy          String?
  lastSeenAt            DateTime?
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  metrics               Metric[]
  unlockReceipts        UnlockReceipt[]
  ratings               ContentRating[]
  events                ContentEvent[]

  @@unique([websiteId, externalId])
  @@unique([websiteId, url])
  @@index([contentType])
  @@index([publisherId])
  @@index([publisherWallet])
  @@index([createdAt])
}

model UnlockReceipt {
  id              String             @id @default(uuid())
  contentId       String
  content         Content            @relation(fields: [contentId], references: [id], onDelete: Cascade)
  websiteId       String
  website         Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  publisherId     String?
  publisher       PublisherIdentity? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  payerWallet     String?
  actor           String?
  paymentId       String
  paymentProvider String?
  txHash          String?
  receiptUrl      String?
  chainId         String?
  network         String?
  amount          Float?
  protocolFee     Float? // feeBps share of amount routed to the treasury via the fee wallet
  currency        String?
  recipientWallet String?
  status          String             @default("verified")
  metadata        String?
  createdAt       DateTime           @default(now())

  @@unique([contentId, paymentId])
  @@index([websiteId])
  @@index([publisherId])
  @@index([payerWallet])
  @@index([txHash])
}

model ContentEvent {
  id        String   @id @default(uuid())
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  websiteId String
  eventType String
  url       String?
  createdAt DateTime @default(now())

  @@index([websiteId, createdAt])
  @@index([contentId])
  @@index([eventType])
}

model ContentRating {
  id            String             @id @default(uuid())
  contentId     String
  content       Content            @relation(fields: [contentId], references: [id], onDelete: Cascade)
  websiteId     String
  website       Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  publisherId   String?
  publisher     PublisherIdentity? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  walletAddress String
  actor         String?
  ratingValue   Int // 1-50, where 45 means 4.5 stars
  reviewHash    String?
  txHash        String?
  proofType     String?
  proof         String?
  status        String             @default("accepted")
  metadata      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([contentId, walletAddress])
  @@index([websiteId])
  @@index([publisherId])
  @@index([walletAddress])
  @@index([txHash])
}

model Metric {
  id          String             @id @default(uuid())
  dedupeKey  String?
  type        String // normalized category: 'view', 'unlock', 'payment', 'engagement', 'time'
  eventName   String? // raw event name: page_view, resource_view, unlock_started, unlock_completed, payment_completed, time_spent
  contentId   String?
  content     Content?           @relation(fields: [contentId], references: [id], onDelete: SetNull)
  websiteId   String
  website     Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  publisherId String?
  publisher   PublisherIdentity? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  revenue     Float? // Revenue earned (if type == 'unlock')
  currency    String?
  path        String?
  url         String?
  referrer    String?
  userAgent   String?
  visitorId   String?
  sessionId   String?
  bucketStart DateTime?
  durationMs  Int?
  scrollDepth Float?
  metadata    String?
  createdAt   DateTime           @default(now())

  @@index([websiteId, type, createdAt])
  @@index([websiteId, eventName, createdAt])
  @@index([websiteId, visitorId, createdAt])
  @@index([contentId, type, createdAt])
  @@index([dedupeKey])
}

model MetricDedupe {
  key       String   @id
  createdAt DateTime @default(now())
}

model BlogPost {
  id           String    @id @default(uuid())
  slug         String    @unique
  title        String
  excerpt      String?
  bodyMarkdown String
  tag          String?
  tags         String?
  coverUrl     String?
  status       String    @default("draft")
  publishedAt  DateTime?
  authorId     String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}

model IndexState {
  id              String    @id @default(uuid())
  url             String    @unique
  domain          String
  coverageState   String?
  indexingState   String?
  lastCrawlTime   DateTime?
  isIndexed       Boolean   @default(false)
  sitemapHash     String?
  lastInspectedAt DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([domain])
  @@index([isIndexed])
}

model NewsletterSubscriber {
  id               String    @id @default(uuid())
  email            String    @unique
  source           String?
  status           String    @default("active")
  resendContactId  String?
  resendSyncedAt   DateTime?
  resendSyncStatus String    @default("pending")
  resendSyncError  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([resendSyncStatus])
  @@index([createdAt])
}

// ── Nibshare (hosted quick-share gated content) ─────────────────────────────
//
// No domain required: a wallet owner publishes an encrypted payload, sets a
// price, an optional expiry and an optional wallet whitelist, and gets a short
// link. Unlock = x402 USDC payment -> access rules checked -> key vended.
//
// Decentralization model (see backend/src/server/nibshare/README.md):
//   - The CIPHERTEXT lives on Nibgate-hosted Cloudflare R2
//     (storageProvider 'nibgate' — the only supported provider today); the
//     plaintext never does.
//   - Integrity is a keccak256 commitment (contentHash), same pattern as the
//     hub's contentHash for Content rows.
//   - Expiry semantics: expiresAt stops NEW unlocks/key issuance. It CANNOT
//     revoke keys already vended.
//   - Whitelist is enforced at key-issuance time: wallets outside it are
//     refused even if they pay.
//   - keyProvider is always 'server': the Nibgate backend holds K and decrypts
//     per session (decryptMode 'server'). 'lit' is a planned tier, not shipped.
//
// NOT in the manifest/ContentEvent sync loop: these are ephemeral and
// wallet-owned, not site-owned.

model NibShare {
  id          String     @id @default(uuid())
  ownerWallet String
  title       String
  summary     String?
  coverUrl    String? // public thumbnail (extracted cover / cover art); media body stays encrypted
  contentType String     @default("text") // text | article | image | link
  bodyLength  Int        @default(0) // plaintext byte length (for pricing/display)

  // Gating
  price    Float    @default(0) // USDC; 0 = free unlock (still requires an unlock call + key)
  currency String   @default("USDC")
  expiresAt DateTime? // null = never. Stops NEW unlocks only; never revokes issued keys.
  whitelist String[] // empty = anyone who pays; non-empty = only these wallets may unlock
  whitelistPrice Float? // USDC; null = whitelist pays the same `price` as everyone else
  publicAccess Boolean @default(true) // false = public cannot unlock at all (invite-only)

  // Storage (ciphertext + public metadata live off-chain)
  storageProvider String  @default("local") // local | nibgate | arweave | ipfs (nibgate = Nibgate-hosted R2, the free tier)
  storageRef      String? // local:<uuid> | ar://<txid> | ipfs://<cid>
  ciphertextUrl   String? // public fetch URL for the encrypted blob (gateway)
  metadataUrl     String? // public fetch URL for the public metadata JSON

  // Integrity
  contentHash String // keccak256("nibshare:v1|ownerWallet|storageRef|plaintextPayload")

  // Key handling
  keyProvider  String  @default("server") // server | lit
  encryptedKey String? // server mode: AES-256-GCM wrapped content key; lit mode: PKP id

  // How the body is delivered (decides the revocation guarantee):
  //   'client' = ciphertext + key vended once; buyer decrypts in-browser.
  //              Decentralized. Revocation is SOFT: stops future sessions but
  //              cannot un-read a copy already decrypted.
  //   'server' = server decrypts and serves the body per session, keyed to a
  //              valid wallet-linked entitlement. Centralized. Revocation is
  //              HARD: revoke the entitlement and the wallet stops seeing it.
  decryptMode String @default("client") // client | server

  // Lifecycle
  status      String   @default("active") // active | expired | revoked
  unlockCount Int      @default(0)
  viewCount   Int      @default(0)
  slug        String   @unique // short link suffix (e.g. 8-char base58)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  receipts    NibShareReceipt[]
  entitlements NibShareEntitlement[]
  events      NibShareEvent[]

  @@index([ownerWallet])
  @@index([status, expiresAt])
  @@index([createdAt])
}

model NibShareEntitlement {
  id        String    @id @default(uuid())
  shareId   String
  share     NibShare  @relation(fields: [shareId], references: [id], onDelete: Cascade)
  wallet    String
  // active = wallet may be served (in 'server' mode) / may unlock (in 'client' mode)
  // revoked = soft: lost access now, may re-pay to re-unlock
  // banned  = hard: revoked + may never pay again
  status    String    @default("active") // active | revoked | banned
  // Where the access right came from. 'paid' = backed by a real receipt
  // (amount > 0) => lifetime. 'free' = whitelist free tier / legacy free grant,
  // re-granted per visit, NOT lifetime by construction.
  source    String    @default("free") // paid | free
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  @@unique([shareId, wallet])
  @@index([wallet])
  @@index([status])
}

model NibShareEvent {
  id        String    @id @default(uuid())
  shareId   String
  share     NibShare  @relation(fields: [shareId], references: [id], onDelete: Cascade)
  type      String // view | revoke
  wallet    String?
  createdAt DateTime  @default(now())

  @@index([shareId, createdAt])
  @@index([createdAt])
}

model NibShareReceipt {
  id          String    @id @default(uuid())
  shareId     String
  share       NibShare  @relation(fields: [shareId], references: [id], onDelete: Cascade)
  payerWallet String
  txHash      String?
  // x402/idempotency key: (txHash, shareId) is the durable identity of one
  // payment + grant. The unique index makes an attacker's replayed proof hit
  // this row and yield the SAME receipt response, never a second grant.
  paymentNonce String? // stable id of one payment+grant (x402 has no paymentId; txHash is it)
  amount      Float
  protocolFee Float? // feeBps share of amount routed to the treasury via the fee wallet
  currency    String    @default("USDC")
  unlockedAt  DateTime  @default(now())
  keyGrantedAt DateTime? // when the decryption key was vended (null = not yet)

  @@index([shareId])
  @@index([payerWallet])
  @@unique([paymentNonce, shareId])
}
