// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid())
  walletAddress String     @unique
  username      String?
  bio           String?
  avatarUrl     String?
  coverUrl      String?
  websiteUrl    String?
  twitterUrl    String?
  instagramUrl  String?
  tiktokUrl     String?
  youtubeUrl    String?
  createdAt     DateTime   @default(now())
  sessions      Session[]
  wallets       Wallet[]
  websites      Website[]
  blogPosts     BlogPost[]
}

model Wallet {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address    String   @unique
  chainId    Int?
  isPrimary  Boolean  @default(false)
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  nonce     String? // Temporary nonce for SIWE login challenges
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Website {
  id                        String              @id @default(uuid())
  domain                    String              @unique
  name                      String
  description               String?
  ownerId                   String
  owner                     User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isVerified                Boolean             @default(false)
  verificationStatus        String              @default("pending")
  lastVerifiedAt            DateTime?
  lastVerificationCheckAt   DateTime?
  verificationFailureReason String?
  verifyToken               String
  siteToken                 String              @unique
  faviconUrl                String?
  ogImageUrl                String?
  lastScanAt                DateTime?
  lastScanStatus            String?
  lastScanError             String?
  lastSyncAt                DateTime?
  createdAt                 DateTime            @default(now())
  settings                  String?
  deletedAt                 DateTime?
  content                   Content[]
  metrics                   Metric[]
  unlockReceipts            UnlockReceipt[]
  ratings                   ContentRating[]
  publishers                PublisherIdentity[]
}

model PublisherIdentity {
  id             String          @id @default(uuid())
  websiteId      String
  website        Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  externalId     String
  handle         String?
  name           String?
  walletAddress  String?
  profileUrl     String?
  verification   String          @default("platform_attested")
  metadata       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  content        Content[]
  metrics        Metric[]
  unlockReceipts UnlockReceipt[]
  ratings        ContentRating[]

  @@unique([websiteId, externalId])
  @@index([websiteId])
  @@index([walletAddress])
  @@index([handle])
}

model Content {
  id                    String             @id @default(uuid())
  websiteId             String
  website               Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  publisherId           String?
  publisher             PublisherIdentity? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  publisherExternalId   String?
  publisherHandle       String?
  publisherWallet       String?
  publisherProfileUrl   String?
  publisherVerification String?
  externalId            String?
  title                 String
  description           String?
  imageUrl              String?
  contentType           String             @default("article") // music, video, article, image
  tags                  String? // Comma-separated tags for the search engine
  url                   String
  path                  String?
  currency              String             @default("USDC")
  price                 Float // Price to unlock in USDC
  recipientWallet       String?
  accessPolicy          String?
  unlockPolicy          String?
  lastSeenAt            DateTime?
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  metrics               Metric[]
  unlockReceipts        UnlockReceipt[]
  ratings               ContentRating[]

  @@unique([websiteId, externalId])
  @@unique([websiteId, url])
  @@index([contentType])
  @@index([publisherId])
  @@index([publisherWallet])
  @@index([createdAt])
}

model UnlockReceipt {
  id              String             @id @default(uuid())
  contentId       String
  content         Content            @relation(fields: [contentId], references: [id], onDelete: Cascade)
  websiteId       String
  website         Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  publisherId     String?
  publisher       PublisherIdentity? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  payerWallet     String?
  actor           String?
  paymentId       String
  paymentProvider String?
  txHash          String?
  receiptUrl      String?
  chainId         String?
  network         String?
  amount          Float?
  currency        String?
  recipientWallet String?
  status          String             @default("verified")
  metadata        String?
  createdAt       DateTime           @default(now())

  @@unique([contentId, paymentId])
  @@index([websiteId])
  @@index([publisherId])
  @@index([payerWallet])
  @@index([txHash])
}

model ContentRating {
  id            String             @id @default(uuid())
  contentId     String
  content       Content            @relation(fields: [contentId], references: [id], onDelete: Cascade)
  websiteId     String
  website       Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  publisherId   String?
  publisher     PublisherIdentity? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  walletAddress String
  actor         String?
  ratingValue   Int // 1-50, where 45 means 4.5 stars
  reviewHash    String?
  txHash        String?
  proofType     String?
  proof         String?
  status        String             @default("accepted")
  metadata      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([contentId, walletAddress])
  @@index([websiteId])
  @@index([publisherId])
  @@index([walletAddress])
  @@index([txHash])
}

model Metric {
  id          String             @id @default(uuid())
  dedupeKey  String?
  type        String // normalized category: 'view', 'unlock', 'payment', 'engagement', 'time'
  eventName   String? // raw event name: page_view, resource_view, unlock_started, unlock_completed, payment_completed, time_spent
  contentId   String?
  content     Content?           @relation(fields: [contentId], references: [id], onDelete: SetNull)
  websiteId   String
  website     Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  publisherId String?
  publisher   PublisherIdentity? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  revenue     Float? // Revenue earned (if type == 'unlock')
  currency    String?
  path        String?
  url         String?
  referrer    String?
  userAgent   String?
  visitorId   String?
  sessionId   String?
  bucketStart DateTime?
  durationMs  Int?
  scrollDepth Float?
  metadata    String?
  createdAt   DateTime           @default(now())

  @@index([websiteId, type, createdAt])
  @@index([websiteId, eventName, createdAt])
  @@index([websiteId, visitorId, createdAt])
  @@index([contentId, type, createdAt])
  @@index([dedupeKey])
}

model MetricDedupe {
  key       String   @id
  createdAt DateTime @default(now())
}

model BlogPost {
  id           String    @id @default(uuid())
  slug         String    @unique
  title        String
  excerpt      String?
  bodyMarkdown String
  tag          String?
  tags         String?
  coverUrl     String?
  status       String    @default("draft")
  publishedAt  DateTime?
  authorId     String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}

model NewsletterSubscriber {
  id               String    @id @default(uuid())
  email            String    @unique
  source           String?
  status           String    @default("active")
  resendContactId  String?
  resendSyncedAt   DateTime?
  resendSyncStatus String    @default("pending")
  resendSyncError  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([resendSyncStatus])
  @@index([createdAt])
}
