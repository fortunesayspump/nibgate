// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// NOTE: We are using SQLite for rapid local development.
// When you deploy to production on Vercel, change this provider to "postgresql"
// and update the DATABASE_URL in your environment variables to point to your Vercel Postgres instance.
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  walletAddress String    @unique
  username      String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  sessions      Session[]
  websites      Website[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  nonce     String?  // Temporary nonce for SIWE login challenges
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Website {
  id          String    @id @default(uuid())
  domain      String    @unique
  name        String
  description String?
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isVerified  Boolean   @default(false)
  verifyToken String
  siteToken   String    @unique
  faviconUrl  String?
  ogImageUrl  String?
  createdAt   DateTime  @default(now())
  content     Content[]
  metrics     Metric[]
}

model Content {
  id          String   @id @default(uuid())
  websiteId   String
  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  title       String
  description String?
  imageUrl    String?
  contentType String   @default("image") // e.g., 'image', 'video', 'audio', 'article'
  tags        String?  // Comma-separated tags for the search engine
  url         String
  price       Float    // Price to unlock in USDC
  createdAt   DateTime @default(now())
  metrics     Metric[]
}

model Metric {
  id          String   @id @default(uuid())
  type        String   // e.g., 'view', 'unlock'
  contentId   String?
  content     Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  websiteId   String
  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  revenue     Float?   // Revenue earned (if type == 'unlock')
  createdAt   DateTime @default(now())
}
