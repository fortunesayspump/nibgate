{
  "name": "@nibgate/sdk",
  "version": "0.2.43",
  "description": "Framework-agnostic browser and server package for creator-owned gated content, unlock events, and receipts.",
  "type": "module",
  "sideEffects": [
    "./src/browser/client.js",
    "./src/browser/events.js",
    "./src/browser/index.js"
  ],
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "import": "./src/server.js",
      "default": "./src/server.js"
    },
    "./tracking": {
      "types": "./src/tracking.d.ts",
      "import": "./src/tracking.js",
      "default": "./src/tracking.js"
    },
    "./testing": {
      "types": "./src/testing.d.ts",
      "import": "./src/testing.js",
      "default": "./src/testing.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/bundle.mjs",
    "prepublishOnly": "npm run build && npm run pack:check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "devDependencies": {
    "esbuild": "^0.25.12",
    "vitest": "^3.2.1"
  },
  "keywords": [
    "nibgate",
    "creator",
    "paywall",
    "analytics",
    "x402"
  ],
  "license": "MIT",
  "dependencies": {
    "@circle-fin/x402-batching": "^3.0.4",
    "@x402/core": "^2.17.0",
    "@x402/evm": "^2.17.0",
    "viem": "^2.54.1"
  }
}
