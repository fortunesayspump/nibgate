{
  "name": "nibgate",
  "version": "0.1.0",
  "description": "Browser SDK for registering gated creator content and streaming unlock events through the Nibgate widget.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "import": "./src/server.js",
      "default": "./src/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "nibgate",
    "creator",
    "paywall",
    "analytics",
    "x402"
  ],
  "license": "MIT"
}
