{
  "name": "@nibgate/wallet",
  "version": "0.4.4",
  "description": "Single Nibgate wallet standard: chain guard, error mapping, SIWE sign-in, and a shared Reown AppKit (AppKit + wagmi) React provider, connect, and unlock.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./chain": "./src/chain.js",
    "./chain.js": "./src/chain.js",
    "./errors": "./src/errors.js",
    "./errors.js": "./src/errors.js",
    "./network": "./src/network.js",
    "./network.js": "./src/network.js",
    "./siwe": "./src/siwe.js",
    "./siwe.js": "./src/siwe.js",
    "./unlock-key": "./src/unlock-key.js",
    "./unlock-key.js": "./src/unlock-key.js",
    "./react": {
      "types": "./src/react/index.d.ts",
      "default": "./src/react/index.js"
    },
    "./react.js": {
      "types": "./src/react/index.d.ts",
      "default": "./src/react/index.js"
    }
  },
  "dependencies": {
    "@nibgate/sdk": "^0.4.0",
    "lottie-web": "^5.12.2",
    "viem": "^2.52.2"
  },
  "peerDependencies": {
    "@reown/appkit": "1.8.21",
    "@reown/appkit-adapter-wagmi": "1.8.21",
    "@tanstack/react-query": "5.101.2",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "wagmi": "3.6.21"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0"
  }
}
