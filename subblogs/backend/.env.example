PORT=4000
NODE_ENV=development
# NIBGATE_NETWORK selects the Arc network (testnet|mainnet, default testnet).
# The testnet stack serves both <name>.nibgate.xyz (legacy) and the canonical
# testnet-<name>.nibgate.xyz alias; the mainnet stack serves <name>.nibgate.xyz.
NIBGATE_NETWORK=testnet
DATABASE_URL="postgresql://user:password@localhost:5432/nibgate_blog"
JWT_SECRET=dc54a599373298699b726355d9d2cfd8ca8fdbb284104bbef70c88f7115784b4
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

NIBGATE_SECRET=change-this-to-your-own-gateway-secret
# Envelope-encryption KEK: wraps per-content DEKs before they are stored. Must
# be a long random secret, unique per backend, and identical across the
# subblogs processes sharing the same R2/database. Rotate only with a backfill.
NIBGATE_SHARE_KEY_SECRET=change-this-to-a-long-random-key-wrapping-secret
# Set your wallet address in Settings → Payment settings → Default wallet (recipient)
CIRCLE_API_KEY=your-circle-api-key-here

R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_BUCKET=nibgate-media
R2_PUBLIC_URL=https://pub-your-bucket.r2.dev
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key

# Vercel domain provisioning on site setup: <name>.nibgate.xyz is added to the
# mainnet frontend project. Testnet aliases (<name>.testnet.nibgate.xyz) need
# no per-site work — they are covered by the *.testnet.nibgate.xyz wildcard.
# VERCEL_PROJECT_ID=<mainnet subblogs frontend project id>
# VERCEL_TOKEN=<vercel api token>

# Arc Testnet RPC (for on-chain rating verification via reputation contract)
# ARC_RPC_URL=https://rpc.testnet.arc-node.thecanteenapp.com/v1/your-token
