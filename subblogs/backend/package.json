{
  "name": "nibgate-blog-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Nibgate Blog API — Express + Prisma + JWT auth",
  "main": "src/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/index.js",
    "start": "npx prisma generate && (npx prisma migrate deploy 2>/dev/null || npx prisma db push --skip-generate --accept-data-loss) && cross-env NODE_ENV=production node src/index.js",
    "seed": "NODE_ENV=development node prisma/seed.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@nibgate/sdk": "file:nibgate-sdk-0.4.7.tgz",
    "@prisma/client": "^6.3.1",
    "@sentry/node": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-status": "^2.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "sharp": "^0.35.3",
    "viem": "^2.23.2",
    "winston": "^3.17.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.3.1"
  }
}
