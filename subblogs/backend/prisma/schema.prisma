generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Site {
  id          String   @id @default(uuid())
  subdomain   String   @unique
  name        String
  description String?
  settings    String?
  verifyToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  blogPosts   BlogPost[]
}

model User {
  id            String     @id @default(uuid())
  siteId        String
  site          Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name          String
  username      String?    @unique
  email         String     @unique
  password      String
  role          String     @default("author")
  bio           String?
  avatarUrl     String?
  isEmailVerified Boolean @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  tokens        Token[]
  blogPosts     BlogPost[]

  @@unique([siteId, email])
}

model Token {
  id          String   @id @default(uuid())
  token       String   @db.VarChar(400)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  expires     DateTime
  blacklisted Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id           String    @id @default(uuid())
  siteId       String
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug         String
  title        String
  excerpt      String?
  bodyMarkdown String
  coverUrl     String?
  videoUrl     String?
  videoName        String?
  videoSize        Int?
  videoStorageRef  String?
  videoEncryptedKey String?
  videoContentType String?
  audioUrl     String?
  audioStorageRef   String?
  audioEncryptedKey String?
  audioContentType  String?
  documentUrl       String?
  documentName      String?
  documentSize      Int?
  documentStorageRef   String?
  documentEncryptedKey String?
  documentContentType  String?
  contentKey   String?
  bodyStorageRef    String?
  media        String?
  tags         String?
  type         String    @default("article")
  price        String?
  recipientWallet String?
  status       String    @default("draft")
  featured     Boolean   @default(false)
  publishedAt  DateTime?
  authorId     String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ratings     Rating[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([siteId, slug])
  @@index([siteId, status, publishedAt])
  @@index([siteId, authorId])
}

model Rating {
  id        String   @id @default(uuid())
  siteId    String
  postId    String
  wallet    String
  rating    Int      @default(0)
  txHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, wallet])
  @@index([siteId])
  @@index([postId])
}
