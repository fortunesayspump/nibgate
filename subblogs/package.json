{
  "name": "nibgate-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Convenience commands for the Subblogs apps in the Nibgate pnpm workspace.",
  "scripts": {
    "dev:backend": "pnpm --dir .. --filter nibgate-blog-backend dev",
    "dev:frontend": "pnpm --dir .. --filter nibgate-blog-frontend dev",
    "dev": "pnpm --dir .. --parallel --filter nibgate-blog-backend --filter nibgate-blog-frontend dev",
    "build:frontend": "pnpm --dir .. --filter nibgate-blog-frontend build",
    "start:backend": "pnpm --dir .. --filter nibgate-blog-backend start",
    "seed": "pnpm --dir .. --filter nibgate-blog-backend seed"
  }
}
