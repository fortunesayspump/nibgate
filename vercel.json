{
  "version": 2,
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/frontend/dist/assets/$1" },
    { "source": "/fonts/(.*)", "destination": "/frontend/dist/fonts/$1" },
    { "source": "/images/(.*)", "destination": "/frontend/dist/images/$1" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
